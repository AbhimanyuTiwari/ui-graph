{
  "name": "uigraph",
  "version": "0.1.0",
  "description": "Deterministic UI knowledge graph for AI test agents. Map routes, screens, and locators from Angular or Next.js, verify them in a real browser, and query them from Cursor, Claude Code, or any MCP client.",
  "author": "Abhimanyu Tiwari <tiwariabhimanyu001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbhimanyuTiwari/ui-graph.git"
  },
  "homepage": "https://github.com/AbhimanyuTiwari/ui-graph",
  "bugs": {
    "url": "https://github.com/AbhimanyuTiwari/ui-graph/issues"
  },
  "keywords": [
    "playwright",
    "ui-testing",
    "e2e",
    "test-automation",
    "locators",
    "accessibility",
    "angular",
    "nextjs",
    "mcp",
    "ai-agents",
    "cursor",
    "claude-code",
    "knowledge-graph",
    "static-analysis"
  ],
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "uigraph": "./dist/cli/index.js"
  },
  "dependencies": {
    "@angular/compiler": "^22.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "playwright": "^1.64.1",
    "ts-morph": "^28.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
